{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Needed to author @Transactional(). Metadata emission is deliberately OFF:
    // our decorators never read design:paramtypes, and esbuild (which vitest and
    // tsup both use) cannot emit it anyway — leaving it on only produced a
    // misleading "@swc/core not installed" warning at build time.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "benchmarks", "*.config.ts", "*.config.mts"],
  "exclude": ["dist", "node_modules", "examples"]
}
